# Supabase (anon key; the meetingsummaries table must allow anon reads)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Secret key required by every /api/* route. Server-side only, never NEXT_PUBLIC_.
SERVER_API_KEY=

# No longer read by the app: NEXT_PUBLIC_SERVER_API_KEY, NEXT_PUBLIC_BASE_URL,
# NEXT_PUBLIC_NODE_ENV. They can be removed from your environment.
